{% extends 'base.twig' %}

{% block title %}Košík – Improtřesk 2027{% endblock %}

{% block content %}
<section class="section">
    <div class="container">

        <h1>Košík</h1>

        {% if error %}
            <div class="alert alert-error">{{ error }}</div>
        {% endif %}
        {% if success %}
            <div class="alert alert-success">{{ success }}</div>
        {% endif %}

        {% set unpaidRegs  = registrations|filter(r => r.payment_status != 'paid') %}
        {% set unpaidPurch = purchases|filter(p => p.payment_status != 'paid') %}

        {% if unpaidRegs is empty and unpaidPurch is empty %}
        <div class="card">
            <div class="card__body">
                <p>Košík je prázdný – nemáte žádné nezaplacené položky.</p>
            </div>
        </div>
        {% else %}

        <div class="wizard-payment-grid">

            {# Order summary #}
            <div class="card">
                <div class="card__header">
                    <h2 class="wizard-section-title">Nezaplacené položky</h2>
                </div>
                <div class="card__body">

                    {% if unpaidRegs is not empty %}
                        <h3 class="wizard-subsection">Workshopy</h3>
                        <table class="wizard-summary-table">
                            {% for r in unpaidRegs %}
                            <tr{% if r.likely_no_spot is defined and r.likely_no_spot %} class="wps-row--nospot"{% endif %}>
                                <td>
                                    {{ r.workshop_name }}
                                    <div class="cart-sub">{{ r.timeslot_name }}</div>
                                    {% if r.likely_no_spot is defined and r.likely_no_spot %}
                                        <div class="wps-nospot-warn">
                                            ⚠ Na workshop se pravděpodobně nedostanete – do platby nezahrnuto.<br>
                                            Doporučujeme změnit workshop.
                                        </div>
                                    {% elseif r.payment_status == 'timeblock' %}
                                        <div class="wps-nospot-warn">⚠ Překrývá se s jiným workshopem – do platby nezahrnuto.</div>
                                    {% endif %}
                                </td>
                                <td class="wizard-summary-price">
                                    {% if r.price > 0 %}{{ r.price|number_format(0, ',', ' ') }} Kč{% endif %}
                                </td>
                                <td class="cart-remove">
                                    <form method="POST" action="/dashboard/cancel-registration">
                                        <input type="hidden" name="_csrf" value="{{ csrf }}">
                                        <input type="hidden" name="_back" value="cart">
                                        <input type="hidden" name="registration_id" value="{{ r.id }}">
                                        <button type="submit" class="cart-remove-btn" title="Odebrat z košíku">✕</button>
                                    </form>
                                </td>
                            </tr>
                            {% endfor %}
                        </table>
                    {% endif %}

                    {% for group, label in {'ticket': 'Vstupenky', 'children': 'Vstupenky na Dětský třesk', 'merch': 'Merch'} %}
                        {% set items = unpaidPurch|filter(p => p.cart_group == group) %}
                        {% if items is not empty %}
                            <h3 class="wizard-subsection">{{ label }}</h3>
                            <table class="wizard-summary-table">
                                {% for p in items %}
                                <tr>
                                    <td>
                                        {{ p.item_name }}
                                        {% if p.quantity > 1 %}&nbsp;×&nbsp;{{ p.quantity }}{% endif %}
                                    </td>
                                    <td class="wizard-summary-price">{{ (p.item_price * p.quantity)|number_format(0, ',', ' ') }} Kč</td>
                                    <td class="cart-remove">
                                        <form method="POST" action="/shop/cancel-purchase">
                                            <input type="hidden" name="_csrf" value="{{ csrf }}">
                                            <input type="hidden" name="_back" value="cart">
                                            <input type="hidden" name="purchase_id" value="{{ p.id }}">
                                            <button type="submit" class="cart-remove-btn" title="Odebrat z košíku">✕</button>
                                        </form>
                                    </td>
                                </tr>
                                {% endfor %}
                            </table>
                        {% endif %}
                    {% endfor %}

                    <div class="wizard-total-row">
                        <span>Celkem k úhradě</span>
                        <strong class="wizard-total-amount">{{ total|number_format(0, ',', ' ') }} Kč</strong>
                    </div>

                    {% if user.hero is defined and user.hero > 0 %}
                    <div class="hero-discount-box">
                        <strong>Sleva za tebo garantovaný workshop</strong>
                        <p>Pro workshop, který garantuješ, si od výše uvedené částky odečti:</p>
                        <table class="hero-discount-table">
                            <tr>
                                <td>Dvoudenní workshop</td>
                                <td>−&nbsp;1&nbsp;000&nbsp;Kč</td>
                            </tr>
                            <tr>
                                <td>Jednodenní workshop</td>
                                <td>−&nbsp;500&nbsp;Kč</td>
                            </tr>
                            <tr>
                                <td>Půldenní workshop</td>
                                <td>−&nbsp;300&nbsp;Kč</td>
                            </tr>
                        </table>
                        <p class="hero-discount-note">Slevu uplatni přímo v platbě – pošli o příslušnou částku méně. 
                
                        Při párování plateb na to pamatuju.  Pokud s tím budeš mít trable, klidně mi brnkni.<br>
                        
                        Vašek 604 209 354</p>
                    </div>
                    {% endif %}
                </div>
            </div>

            {% if not show_payment %}
            {# Step 1: "Chci zaplatit" – required questions (if needed) + reminder opt-in #}
            <div class="card">
                <div class="card__header">
                    <h2 class="wizard-section-title">Platba</h2>
                </div>
                <div class="card__body">
                    <form method="POST" action="/cart/pay" class="cart-pay-form">
                        <input type="hidden" name="_csrf" value="{{ csrf }}">

                        {% if needs_questions is not empty %}
                            <p class="cart-pay-intro"><strong>Před platbou prosím vyplňte povinné otázky</strong> (najdete je i ve <a href="/dashboard">svém přehledu</a>):</p>
                            {% for q in needs_questions %}
                                <div class="uq-question-block">
                                    <p class="uq-question-text"><strong>{{ q.question }}</strong><span class="uq-required-mark" title="Povinná otázka"> *</span></p>
                                    {% if q.description %}
                                        <p class="uq-description">{{ q.description|nl2br }}</p>
                                    {% endif %}
                                    {% if q.ticket_id %}
                                        <p>Při odpovědi „Ano“ vám do košíku automaticky přidáme patřičnou vstupenku.</p>
                                    {% endif %}
                                    {% if q.type == 'yes_no' %}
                                        <label class="uq-radio"><input type="radio" name="answers[{{ q.id }}]" value="yes" required> Ano</label>
                                        <label class="uq-radio"><input type="radio" name="answers[{{ q.id }}]" value="no"> Ne</label>
                                    {% elseif q.type == 'phone' %}
                                        <input type="tel" name="answers[{{ q.id }}]" class="uq-input" placeholder="+420 ..." required>
                                    {% else %}
                                        <input type="text" name="answers[{{ q.id }}]" class="uq-input" required>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        {% endif %}

                        <label class="cart-remind">
                            <input type="checkbox" name="remind" value="1">
                            Pošli mi připomínku mailem
                        </label>

                        <button type="submit" class="btn btn--primary btn--block">Chci zaplatit</button>
                    </form>
                </div>
            </div>
            {% else %}
            {# Step 2: payment details #}
            <div class="card">
                <div class="card__header">
                    <h2 class="wizard-section-title">Jak zaplatit</h2>
                </div>
                <div class="card__body">
                    {% if reminder_on %}
                        <p class="cart-remind-note">✉ Platební údaje vám za pár minut pošleme i e-mailem.</p>
                    {% endif %}
                    <div class="wizard-qr-wrap">
                        <img src="{{ qr }}" alt="QR kód pro platbu" class="wizard-qr-img">
                        <p class="wizard-qr-caption">Naskenujte QR kód v mobilním bankovnictví</p>
                    </div>

                    <div class="wizard-bank-details">
                        <div class="wizard-bank-row">
                            <span class="wizard-bank-label">Číslo účtu</span>
                            <span class="wizard-bank-value">{{ payment.readable }}</span>
                        </div>
                        <div class="wizard-bank-row">
                            <span class="wizard-bank-label">Variabilní symbol</span>
                            <span class="wizard-bank-value">{{ payment.variable_symbol }}</span>
                        </div>
                        <div class="wizard-bank-row">
                            <span class="wizard-bank-label">Částka</span>
                            <span class="wizard-bank-value">{{ payment.amount|number_format(0, ',', ' ') }} {{ payment.currency }}</span>
                        </div>
                        {% if payment.message %}
                        <div class="wizard-bank-row">
                            <span class="wizard-bank-label">Zpráva pro příjemce</span>
                            <span class="wizard-bank-value">{{ payment.message }}</span>
                        </div>
                        {% endif %}
                    </div>

                    <p class="wizard-payment-note">
                        Po připsání platby vás budeme informovat e-mailem. Registrace jsou platné po úhradě.
                        Na úhradu máte<strong> šest hodin</strong>.
                    </p>
                </div>
            </div>
            {% endif %}

        </div>
        {% endif %}

        <div class="wizard-nav">
            <a href="/workshops" class="btn btn--outline">Workshopy</a>
            <a href="/tickets" class="btn btn--outline">Vstupenky</a>
            {% if merch_enabled %}
            <a href="/merch" class="btn btn--outline">Merch</a>
            {% endif %}
            <a href="/children" class="btn btn--outline">Dětský třesk</a>
            <a href="/dashboard" class="btn btn--primary">Přejít na můj přehled</a>
        </div>

    </div>
</section>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.wizard-payment-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
}
@media (max-width: 700px) {
    .wizard-payment-grid { grid-template-columns: 1fr; }
}
.wizard-section-title { margin: 0; font-size: 1.1rem; }
.wizard-subsection {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-muted, #666);
    margin: 1rem 0 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}
.wizard-summary-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
.wizard-summary-table td { padding: 0.35rem 0.25rem; vertical-align: middle; }
.wizard-summary-status { text-align: center; }
.wizard-summary-price  { text-align: right; white-space: nowrap; font-weight: 600; }
.wizard-status {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
}
.wizard-status--pending  { background: #fff3cd; color: #856404; }
.wizard-status--approved { background: #d1ecf1; color: #0c5460; }
.wizard-status--paid     { background: #d4edda; color: #155724; }
.wizard-total-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 2px solid var(--color-border, #e0e0e0);
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    font-size: 1rem;
}
.wizard-total-amount { font-size: 1.25rem; color: var(--color-primary, #c0392b); }
.wizard-qr-wrap    { text-align: center; margin-bottom: 1.25rem; }
.wizard-qr-img     { max-width: 180px; height: auto; border: 1px solid var(--color-border, #e0e0e0); border-radius: 6px; padding: 0.5rem; }
.wizard-qr-caption { margin: 0.4rem 0 0; font-size: 0.82rem; color: var(--color-muted, #777); }
.wizard-bank-details { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1rem; }
.wizard-bank-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.95rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--color-border, #f0f0f0);
}
.wizard-bank-label { color: var(--color-muted, #666); white-space: nowrap; }
.wizard-bank-value { font-weight: 600; word-break: break-all; text-align: right; }
.wps-queue {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    background: #e8f4fd;
    color: #1a6fa8;
    margin-left: 0.35rem;
    vertical-align: middle;
}
.wps-nospot-warn {
    font-size: 0.8rem;
    color: #856404;
    margin-top: 0.2rem;
}
.wps-row--nospot td {
    opacity: 0.65;
}
.wizard-payment-note {
    font-size: 0.85rem;
    color: var(--color-muted, #666);
    background: #f8f9fa;
    border-radius: 6px;
    padding: 0.75rem;
    margin: 0;
}
.hero-discount-box {
    margin-top: 1rem;
    padding: .75rem 1rem;
    background: #fffbea;
    border-left: 4px solid #f0c040;
    border-radius: 0 6px 6px 0;
    font-size: .9rem;
}
.hero-discount-box strong { display: block; margin-bottom: .35rem; }
.hero-discount-box p { margin: .35rem 0; color: #555; }
.hero-discount-table {
    width: 100%;
    border-collapse: collapse;
    margin: .5rem 0;
}
.hero-discount-table td {
    padding: .25rem .25rem;
    border-bottom: 1px solid #f0e0a0;
}
.hero-discount-table td:last-child {
    text-align: right;
    font-weight: 600;
    white-space: nowrap;
    color: #b8860b;
}
.hero-discount-note {
    font-size: .8rem;
    color: #888;
    margin-top: .4rem !important;
}
.cart-sub { font-size: 0.8rem; color: var(--color-muted, #777); }
.cart-remove { width: 2rem; text-align: right; }
.cart-remove form { margin: 0; }
.cart-remove-btn {
    border: none;
    background: none;
    color: #c0392b;
    font-size: 1rem;
    cursor: pointer;
    padding: 0.2rem 0.4rem;
}
.cart-remove-btn:hover { background: #fdecea; border-radius: 4px; }
.cart-pay-intro { margin-top: 0; }
.cart-remind {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 0;
    cursor: pointer;
}
.cart-remind-note {
    margin: 0 0 1rem;
    font-size: 0.9rem;
    color: #1a6fa8;
}
.uq-question-block { margin-bottom: 1rem; }
.uq-question-text { margin: 0 0 0.25rem; }
.uq-description { margin: 0 0 0.4rem; font-size: 0.85rem; color: var(--color-muted, #666); }
.uq-required-mark { color: #c0392b; }
.uq-radio { margin-right: 1rem; cursor: pointer; }
.uq-input {
    width: 100%;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--color-border, #ccc);
    border-radius: 5px;
    font-size: 1rem;
    box-sizing: border-box;
}
</style>
{% endblock %}
