{% macro user_table(users, empty_label) %}
<table class="admin-table admin-users-table">
    <thead>
        <tr>
            <th>Jméno</th>
            <th>E-mail</th>
            <th title="Hrdina / hrdinka">H</th>
            <th title="Počet aktivních registrací">Reg.</th>
            <th title="Počet aktivních nákupů">Nák.</th>
            <th title="Počet spárovaných transakcí">Tx</th>
            <th>Poznámka</th>
        </tr>
    </thead>
    <tbody>
        {% for u in users %}
        <tr class="{% if u.transaction_count > 0 %}user-row--has-tx{% endif %}">
            <td>
                <a href="/admin/users/{{ u.id }}">{{ u.name }}</a>
            </td>
            <td><a href="mailto:{{ u.email }}">{{ u.email }}</a></td>
            <td class="text-center">
                {% if u.hero == 1 %}
                    <span class="pairing-badge pairing-badge--hero" title="Hrdina">H</span>
                {% elseif u.hero == 2 %}
                    <span class="pairing-badge pairing-badge--hero" title="Hrdinka">H</span>
                {% endif %}
            </td>
            <td class="text-center">{{ u.registration_count > 0 ? u.registration_count : '–' }}</td>
            <td class="text-center">{{ u.purchase_count > 0 ? u.purchase_count : '–' }}</td>
            <td class="text-center">
                {% if u.transaction_count > 0 %}
                    <span class="pairing-badge pairing-badge--done" title="Má spárované transakce">{{ u.transaction_count }}</span>
                {% else %}
                    <span class="user-no-tx">–</span>
                {% endif %}
            </td>
            <td class="user-note-cell">
                {% if u.note %}
                    <span class="user-note-preview" title="{{ u.note }}">{{ u.note|slice(0, 60) }}{% if u.note|length > 60 %}…{% endif %}</span>
                {% else %}
                    <span class="user-no-tx">–</span>
                {% endif %}
            </td>
        </tr>
        {% else %}
        <tr><td colspan="7">{{ empty_label }}</td></tr>
        {% endfor %}
    </tbody>
</table>
{% endmacro %}

{% import _self as m %}

<p class="admin-users-count">
    Celkem uživatelů: <strong>{{ (users_not_checked_in|length) + (users_checked_in|length) + (users_no_paid_items|length) }}</strong>
</p>

<h2 class="admin-users-section-heading">Čekají na checkin<span class="admin-users-section-count">{{ users_not_checked_in|length }}</span></h2>
{{ m.user_table(users_not_checked_in, 'Žádní uživatelé v této skupině.') }}

<h2 class="admin-users-section-heading admin-users-section-heading--checked">Prošli checkinem<span class="admin-users-section-count">{{ users_checked_in|length }}</span></h2>
{{ m.user_table(users_checked_in, 'Žádní uživatelé v této skupině.') }}

<h2 class="admin-users-section-heading admin-users-section-heading--empty">Bez zaplaceného workshopu nebo vstupenky <span class="admin-users-section-count">{{ users_no_paid_items|length }}</span></h2>
{{ m.user_table(users_no_paid_items, 'Žádní uživatelé v této skupině.') }}

<style>
.admin-users-count { margin-bottom: 1rem; color: var(--color-muted, #666); }
.admin-users-table td, .admin-users-table th { vertical-align: middle; }
.text-center { text-align: center; }
.admin-users-section-heading {
    font-size: 1.1rem;
    margin: 2rem 0 0.5rem;
    padding-bottom: 0.3rem;
    border-bottom: 2px solid #e0e0e0;
}
.admin-users-section-heading--checked { border-color: #27ae60; }
.admin-users-section-heading--empty   { border-color: #e67e22; }
.admin-users-section-count {
    font-size: 0.85rem;
    font-weight: normal;
    color: var(--color-muted, #666);
    margin-left: 0.4rem;
}
.user-row--has-tx > td:first-child::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #27ae60;
    margin-right: 6px;
    vertical-align: middle;
}
.user-no-tx { color: var(--color-muted, #bbb); }
.user-note-cell { max-width: 220px; }
.user-note-preview { font-size: 0.83rem; color: var(--color-muted, #555); cursor: default; }
.pairing-badge--hero { background: #fff3cd; color: #856404; }
</style>
