{% set type_labels = {child: 'Dětská vstupenka', adult: 'Dospělá vstupenka', family: 'Rodinná vstupenka (2+2)'} %}
<div class="container">
    <h1>Dětský Třesk</h1>

    {% if success %}
        <div class="alert alert-success">{{ success }} <a href="/cart">Přejít do košíku</a></div>
    {% endif %}

     {% for field in ['children_start_1','children_start_2','children_start_3','children_start_4'] %}
            {% for block in static  %}{%  if block.block_name == field %}
            <div class="card">
                <div class="card__body">
                        <h3>{{ block.title }} </h2>
                        {{ block.content|raw}}
                </div>
            </div>                
        {% endif %}{% endfor %}{% endfor %}




    {% if items is empty %}
        <div class="card">
            <div class="card__body">
                <p>Momentálně nejsou k dispozici žádné informace o dětském programu.</p>
            </div>
        </div>
    {% else %}
        {% for item in items %}
            <section class="children-date-section" id="den_{{ item.date }}">
                <h2 class="children-date-heading random{{ loop.index }}">{{ item.date|date('j. n. Y') }} {{ item.start_time[:5] }}</h2>
                
                    <div class="children-item card" id="item_{{ item.id }}">
                        <div class="card__body vstupenka_father">
                            {% if user and item.tickets is not empty %}
                                <button type="button" class="vstupenky" aria-expanded="false" aria-controls="tickets_{{ item.id }}">
                                    Vstupenky
                                </button>
                            {% endif %}


                             <h3 class="children-item-title">{{ item.title }}</h3>
                             
                                    {% if item.performer %}
                                        <div class="children-item-performer">{{ item.performer |raw}}</div>
                                    {% endif %}
                                    <div class="children-item-time">
 
                                        {% if item.location %}
                                            &mdash; {{ item.location }}
                                        {% endif %}
                                    </div>
                                           {% if item.photo %}
                                                <img style="float:right;width:50%;margin-left:3em;margin-bottom:1em;border:thick solid grey;"
                                                     src="img/{{ item.photo }}" alt="Medailonek"/>
                                            {% endif %}

                                    {% if item.description %}
                                        <p class="children-item-description">{{ item.description|raw|nl2br|cz_nbsp }}</p>
                                    {% endif %}
                                    
                                            {% if item.bio_name %}
                                                <h3 class="person-card__name" style="margin-bottom:4px;">{{ item.bio_name }}</h3>
                                            {% endif %}
                                            <div class="person-card__links">
                                                {% if item.bio_web_link %}
                                                    <a href="{{ item.bio_web_link }}" target="_blank" rel="noopener noreferrer"
                                                       class="person-card__link person-card__link--web" title="Web">Web</a>
                                                {% endif %}
                                                {% if item.bio_facebook_link %}
                                                    <a href="{{ item.bio_facebook_link }}" target="_blank" rel="noopener noreferrer"
                                                       class="person-card__link person-card__link--fb" title="Facebook">FB</a>
                                                {% endif %}
                                                {% if item.bio_instagram_link %}
                                                    <a href="{{ item.bio_instagram_link }}" target="_blank" rel="noopener noreferrer"
                                                       class="person-card__link person-card__link--ig" title="Instagram">IG</a>
                                                {% endif %}
                                                {% if item.bio_web_link or item.bio_facebook_link or item.bio_instagram_link %}
                                                    <br>
                                                {% endif %}
                                                {% if item.bio_description %}
                                                    <p class="person-card__description">{{ item.bio_description|raw|nl2br|cz_nbsp }}</p>
                                                {% endif %}
                                            </div>

                            {% if user and item.tickets is not empty %}
                                <form method="POST" action="/children/add-to-cart" class="children-tickets" id="tickets_{{ item.id }}" hidden>
                                    <input type="hidden" name="_csrf" value="{{ csrf }}">
                                    <input type="hidden" name="children_item_id" value="{{ item.id }}">
                                    <h4 class="children-tickets__heading">Vstupenky na toto představení</h4>
                                    {% for ticket in item.tickets %}
                                        <div class="children-tickets__row">
                                            <div>
                                                <span class="children-tickets__name">{{ type_labels[ticket.type] ?? ticket.name }}</span>
                                                <span class="children-tickets__price">{{ ticket.price|number_format(0, ',', ' ') }} Kč / ks</span>
                                                {% if in_cart[ticket.id] ?? 0 %}
                                                    <span class="children-tickets__incart">V košíku: {{ in_cart[ticket.id] }}&times;</span>
                                                {% endif %}
                                            </div>
                                            <div class="children-tickets__qty">
                                                <button type="button" class="children-qty-btn" data-step="-1" aria-label="Ubrat">−</button>
                                                <input type="number" name="tickets[{{ ticket.id }}]" value="0" min="0" max="20" class="children-qty-input">
                                                <button type="button" class="children-qty-btn" data-step="1" aria-label="Přidat">+</button>
                                            </div>
                                        </div>
                                    {% endfor %}
                                    <button type="submit" class="btn btn--primary btn--sm children-tickets__submit">Přidat do košíku</button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                
            </section>
        {% endfor %}
    {% endif %}
        {% for field in ['children_end_1','children_end_2','children_end_3','children_end_4'] %}
            {% for block in static  %}{%  if block.block_name == field %}
            <div class="card">
                <div class="card__body">
                        <h3>{{ block.title }} </h2>
                        {{ block.content|raw}}
                </div>
            </div>                
        {% endif %}{% endfor %}{% endfor %}



</div>

<style>
.children-date-section {
    margin-bottom: 2.5rem;
}
.children-date-heading {
    margin-bottom: 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--color-primary, #c0392b);
}
.children-item {
    margin-bottom: 1rem;
}
.children-item-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
}
@media (max-width: 700px) {
    .children-item-grid {
        grid-template-columns: 1fr;
    }
}
.children-item-title {
    margin-bottom: 0.3rem;
}
.children-item-performer {
    color: var(--color-text-secondary, #666);
    margin-bottom: 0.4rem;
    font-style: italic;
}
.children-item-time {
    font-size: 0.9rem;
    color: var(--color-muted, #888);
    margin-bottom: 0.6rem;
}
.children-item-description {
    margin-top: 0.5rem;
}
.vstupenka_father{
    overflow: hidden;
    position: relative;

}
button.vstupenky{
    border: none;
    cursor: pointer;
    font-family: inherit;
    z-index: 1;
    position: absolute;
    top: 28px;
    right: -36px;
    width: 160px;
    background: #D85A30;
    color: #fff;
    text-align: center;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    padding: 7px 0;
    transform: rotate(45deg);
    transform-origin: center;    
}
button.vstupenky:hover,
button.vstupenky[aria-expanded="true"] { background: #b8461f; }
.children-tickets {
    clear: both;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border, #e8e8e8);
}
.children-tickets__heading {
    margin: 0 0 0.6rem;
    font-size: 0.95rem;
    color: var(--color-muted, #555);
    text-transform: uppercase;
    letter-spacing: 0.03em;
}
.children-tickets__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border, #f2f2f2);
    flex-wrap: wrap;
}
.children-tickets__row > div:first-child { display: flex; flex-direction: column; gap: 0.1rem; }
.children-tickets__name   { font-weight: 600; }
.children-tickets__price  { font-size: 0.82rem; color: var(--color-muted, #888); }
.children-tickets__incart { font-size: 0.82rem; font-weight: 600; color: #27ae60; }
.children-tickets__qty { display: flex; align-items: center; gap: 0.3rem; }
.children-qty-btn {
    width: 2rem; height: 2rem;
    border: 1px solid var(--color-border, #ccc);
    border-radius: 4px;
    background: #f7f7f7;
    font-size: 1.1rem;
    cursor: pointer;
    padding: 0;
}
.children-qty-input {
    width: 3rem;
    text-align: center;
    border: 1px solid var(--color-border, #ccc);
    border-radius: 4px;
    padding: 0.25rem;
    -moz-appearance: textfield;
}
.children-qty-input::-webkit-outer-spin-button,
.children-qty-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
.children-tickets__submit { margin-top: 0.75rem; }
</style>

<script>
(function () {
    // Ribbon toggles the ticket section of its card
    document.querySelectorAll('button.vstupenky').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var section = document.getElementById(btn.getAttribute('aria-controls'));
            if (!section) return;
            section.hidden = !section.hidden;
            btn.setAttribute('aria-expanded', section.hidden ? 'false' : 'true');
            if (!section.hidden) section.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });
    });
    // +/- quantity buttons
    document.querySelectorAll('.children-qty-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var input = btn.parentNode.querySelector('.children-qty-input');
            var val = (parseInt(input.value, 10) || 0) + parseInt(btn.dataset.step, 10);
            input.value = Math.max(0, Math.min(20, val));
        });
    });
    // Open the section after returning from "add to cart"
    var m = location.hash.match(/^#item_(\d+)$/);
    if (m) {
        var btn = document.querySelector('button.vstupenky[aria-controls="tickets_' + m[1] + '"]');
        if (btn) btn.click();
    }
}());
</script>
