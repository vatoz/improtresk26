<!-- Navigation -->
<nav class="navbar">
    <div class="container">
        <div class="navbar-content">
            <div class="navbar-brand">
                <a href="/">
                    <h2><span style="color:#a85f31ff">I</span><span style="color:#ecb737ff">M</span><span style="color:#d45842ff">P</span><span style="color:#47a8afff">R</span><span style="color:#98a239ff">O</span><span style="color:#3c66a6ff">T</span><span style="color:#7e4994ff">Ř</span><span style="color:#a44c7dff">E</span><span style="color:#768f89ff">S</span><span style="color:#7e8845ff">K</span></h2>
                </a>

            </div>
            <div class="navbar-warning">
                <!-- empty --!>                
            </div>
            <div class="navbar-menu">
                <button id="menu-toggle" class="menu-toggle">☰</button>
                <div class="navbar-links" id="navbar-links">
                    <a href="/" {% if active_page == 'home' or not active_page %}class="active"{% endif %}>Domů</a>
                    <a href="/workshops" {% if active_page == 'workshops' %}class="active"{% endif %}>Workshopy</a>
                    <a href="/tickets" {% if active_page == 'tickets' %}class="active"{% endif %}>Vstupenky</a>
                    {% if merch_enabled %}
                    <a href="/merch" {% if active_page == 'merch' %}class="active"{% endif %}>Merch</a>
                    {% endif %}
                    <a href="/program" {% if active_page == 'program' %}class="active"{% endif %}>Program</a>
                    <a href="/harmonogram" {% if active_page == 'harmonogram' %}class="active"{% endif %}>Harmonogram</a>
                    <a href="/children" {% if active_page == 'children' %}class="active"{% endif %}>DětskýTřesk</a>
                    <a href="/info" {% if active_page == 'info' %}class="active"{% endif %}>Informace</a>
                    <a href="/medailonky" {% if active_page == 'medailonky' %}class="active"{% endif %}>Medailonky</a>
                    <a href="/faq" {% if active_page == 'faq' %}class="active"{% endif %}>FAQ</a>
                    <a href="/contact" {% if active_page == 'contact' %}class="active"{% endif %}>Kontakt</a>
                    <div class="auth-buttons">
                        {% if user %}
                            <a href="/cart" class="nav-cart{% if active_page == 'cart' %} active{% endif %}" title="Košík"
                               data-count="{{ cart_count ?? 0 }}"{% if cart_changed ?? false %} data-cart-changed="1"{% endif %}>
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                                <span class="nav-cart__count"{% if not (cart_count ?? 0) %} hidden{% endif %}>{{ cart_count ?? 0 }}</span>
                                <span class="nav-cart__label">Košík</span>
                            </a>
                            <a href="/dashboard" class="btn btn--outline btn--sm">U:{{ user.name }}</a>
                            {% if user.role == 'admin' %}
                                <a href="/admin" class="btn btn--secondary btn--sm">Admin</a>
                            {% endif %}
                            <a href="/logout" class="btn btn--outline btn--sm">Odhlásit</a>
                        {% else %}
                           <a href="/login" id="login-btn" class="btn btn--outline btn--sm">Přihlásit se</a>
                           <a href="/register" id="register-btn" class="btn btn--primary btn--sm">Registrovat</a>                            
                        {% endif %}
                    </div>

                       
                    <a href="https://www.facebook.com/events/4577643462483727/" style="border:thin solid #1877F2;border-radius:5px;">FB událost</a> 
                
                </div>
            </div>
        </div>
    </div>
</nav>
